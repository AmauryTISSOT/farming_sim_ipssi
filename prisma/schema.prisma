// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Field {
    id Int @id
    type String
    state String
    yield Int
    machineType String[]
    stopped Boolean
    isSowed Boolean
    currentlyCultivated Boolean    
}

model Factory {
    id Int @id
    type String
    requiredGoods String[]
    result String
    multiplier Int
    stopped Boolean
}

model Machine {
    id Int @id
    type String
    onTheField Boolean
}

model StockItem {
    id Int @id @default(autoincrement())
    key String
    value Int
}